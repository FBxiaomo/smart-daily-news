# Comma-separated recipient mailboxes.
DAILY_NEWS_EMAIL_TO=
DAILY_NEWS_WEBHOOK_URL=
DAILY_NEWS_WEBHOOK_TOKEN=
DAILY_NEWS_WEBHOOK_SECRET=
